<?xml version="1.0" encoding="utf-8"?>
<!-- Shown while a food photo loads, or when a product has no photo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#EEF0F5" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/ic_food_placeholder"
        android:top="14dp" android:bottom="14dp" android:left="14dp" android:right="14dp" />
</layer-list>

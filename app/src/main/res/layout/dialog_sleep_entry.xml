<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I went to bed at"
        android:textColor="#8A8A8A"
        android:textSize="13sp" />

    <Button
        android:id="@+id/dialogBedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/main_navy"
        app:cornerRadius="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="I woke up at"
        android:textColor="#8A8A8A"
        android:textSize="13sp" />

    <Button
        android:id="@+id/dialogWakeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/text_dark_green"
        app:cornerRadius="16dp" />

    <TextView
        android:id="@+id/dialogPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="@color/navy_text"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
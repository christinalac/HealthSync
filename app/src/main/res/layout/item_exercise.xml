<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_excercise_item"
    android:padding="12dp">

    <!-- 1. Category Dot (Now on the Left Side) -->
    <View
        android:id="@+id/viewDot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:background="@drawable/bg_dot"
        android:backgroundTint="#1A237E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Text Group (Middle) -->
    <LinearLayout
        android:id="@+id/textGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cbExerciseStatus"
        app:layout_constraintStart_toEndOf="@id/viewDot"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Exercise Title -->
        <TextView
            android:id="@+id/tvExerciseName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bench Press"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Subtitle Details -->
        <TextView
            android:id="@+id/tvExerciseDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Chest · 4×10 · 135 lbs"
            android:textColor="#888888"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 3. Checkbox (Now on the Far Right Side) -->
    <CheckBox
        android:id="@+id/cbExerciseStatus"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@android:color/transparent"
        android:button="@drawable/custom_checkbox"
        android:checked="false"
        app:buttonTint="@null"
        app:useMaterialThemeColors="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

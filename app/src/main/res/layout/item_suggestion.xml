<?xml version="1.0" encoding="utf-8"?>
<!-- Program Name: item_suggestion.xml
     Developer: Anthony Ramirez and Christina LaCombe
     Date Created: 11/15/2026
     Version: 1.1
     Purpose: One row in the suggestions pop-up: name, details, why it was
     picked, and an Add button (only shown on the tab that can add it). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_excercise_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSuggestionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSuggestionDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Why it was suggested, in green so it stands out -->
        <TextView
            android:id="@+id/tvSuggestionReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_dark_green"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAddSuggestion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minHeight="48dp"
        android:text="Add"
        android:textColor="@android:color/white"
        app:backgroundTint="@color/text_dark_green"
        app:cornerRadius="16dp" />
</LinearLayout>

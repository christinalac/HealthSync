<?xml version="1.0" encoding="utf-8"?>
<!--
    login_screen.xml
    This is the first screen the user sees when they open the app.
    It contains the app name, a tagline, and two buttons:
      - Log In     → takes the user to the Home/Progress screen
      - Create Account → placeholder for now (no registration screen yet)

    ConstraintLayout is used here — each View needs app:layout_constraint*
    attributes to position it. Think of them as anchors that say
    "attach this edge to that edge of another view or the parent."
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background_cream"
    tools:context=".SplashActivity">

    <!-- App name displayed at the top center of the screen -->
    <TextView
        android:id="@+id/textAppName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="HealthSync"
        android:textAlignment="center"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/navy_text"/>

    <!-- Short tagline shown below the app name -->
    <TextView
        android:id="@+id/textTagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Meet your body goals"
        android:textSize="16sp"
        android:textAlignment="center"
        android:textColor="@color/navy_text"/>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="24dp"
        android:background="@drawable/custom_edittext">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!--
        Log In button — tapping this calls the setOnClickListener in
        SplashActivity.kt which launches ProgressActivity
        The ID must match what's used in findViewById() in the Kotlin file
    -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Login"
                android:id="@+id/loginText"
                android:textSize="36sp"
                android:textAlignment="center"
                android:textStyle="bold"
                android:textColor="@color/text_dark_green"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:id="@+id/username"
                android:background="@drawable/custom_edittext"
                android:drawableLeft="@drawable/ic_baseline_lock_24"
                android:drawablePadding="8dp"
                android:hint="Username"
                android:padding="8dp"
                android:textColor="@color/black"
                android:textColorHighlight="@color/main_navy"
                android:layout_marginTop="20dp"/>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:id="@+id/password"
                android:background="@drawable/custom_edittext"
                android:drawableLeft="@drawable/ic_baseline_lock_24"
                android:drawablePadding="8dp"
                android:hint="Password"
                android:padding="8dp"
                android:inputType="textPassword"
                android:textColor="@color/black"
                android:textColorHighlight="@color/main_navy"
                android:layout_marginTop="20dp"/>

            <Button
                android:id="@+id/buttonLogin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginStart="30dp"
                android:layout_marginTop="60dp"
                android:layout_marginEnd="40dp"
                android:text="Login"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:backgroundTint="@color/main_navy"
                app:cornerRadius = "20dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!--
Create Account button — placeholder for now.
No Kotlin logic is wired to this yet, but it needs to exist in the XML
so the layout looks complete during the demo walkthrough.
-->
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Not yet registered? SignUp Now"
        android:textSize="14sp"
        android:textAlignment="center"
        android:id="@+id/signupText"
        android:textColor="@color/white"
        android:backgroundTint="@color/main_navy"
        android:layout_marginBottom="20dp"/>

</LinearLayout>


<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nutrition_cream">

    <!-- ===== Header ===== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/nutrition_navy"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nutrition &amp; Hydration"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderKcal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/nutrition_green_light"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Scrolling content ===== -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="96dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Calorie Summary card ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CALORIE SUMMARY"
                        android:textColor="@color/nutrition_navy_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Goal − Eaten = Left -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout style="@style/CalorieColumn">
                            <TextView android:id="@+id/tvGoal" style="@style/CalorieNumber"
                                android:textColor="@color/nutrition_navy" />
                            <TextView style="@style/CalorieLabel" android:text="Goal" />
                        </LinearLayout>

                        <TextView style="@style/CalorieOperator" android:text="−" />

                        <LinearLayout style="@style/CalorieColumn">
                            <TextView android:id="@+id/tvEaten" style="@style/CalorieNumber"
                                android:textColor="@color/nutrition_green_light" />
                            <TextView style="@style/CalorieLabel" android:text="Eaten" />
                        </LinearLayout>

                        <TextView style="@style/CalorieOperator" android:text="=" />

                        <LinearLayout style="@style/CalorieColumn">
                            <TextView android:id="@+id/tvLeft" style="@style/CalorieNumber"
                                android:textColor="@color/nutrition_green_dark" />
                            <TextView style="@style/CalorieLabel" android:text="Left" />
                        </LinearLayout>
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/calorieProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="16dp"
                        android:max="100"
                        android:progressDrawable="@drawable/progress_calories" />

                    <!-- Macros -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/CalorieColumn">
                            <TextView android:id="@+id/tvCarbs" style="@style/MacroValue"
                                android:textColor="#8FA8C8" />
                            <TextView style="@style/CalorieLabel" android:text="Carbs" />
                        </LinearLayout>
                        <LinearLayout style="@style/CalorieColumn">
                            <TextView android:id="@+id/tvProtein" style="@style/MacroValue"
                                android:textColor="@color/nutrition_navy" />
                            <TextView style="@style/CalorieLabel" android:text="Protein" />
                        </LinearLayout>
                        <LinearLayout style="@style/CalorieColumn">
                            <TextView android:id="@+id/tvFat" style="@style/MacroValue"
                                android:textColor="@color/nutrition_green_dark" />
                            <TextView style="@style/CalorieLabel" android:text="Fat" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Hydration card (tap = +1 glass) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/hydrationCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvHydrationTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/nutrition_navy_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Animated water bar: fills left -> right as glasses are logged -->
                    <com.example.healthsync.WaterProgressBar
                        android:id="@+id/waterBar"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/tvGlassCount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="end"
                        android:textColor="@color/nutrition_navy_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Tap to log a glass (250ml) · Long-press to undo"
                        android:textColor="#8A8A8A"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TODO: Today's Meals card goes here when meal tracking is built -->

        </LinearLayout>
    </ScrollView>

    <!-- ===== "+" FAB (not wired up yet; will open meal picker) ===== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Add meal"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/nutrition_green_dark"
        app:tint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== Bottom tab bar ===== -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/nutrition_navy"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemIconTint="@android:color/white"
        app:itemTextColor="@android:color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
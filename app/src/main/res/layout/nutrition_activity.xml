<?xml version="1.0" encoding="utf-8"?>
<!--
    nutrition_activity.xml
    This is the Nutrition screen (Tab 2).
    Placeholder layout showing section titles for:
      - Calorie Summary
      - Hydration
      - Today's Meals
    The "+" button is present but does nothing yet.
    Real data and API integration comes later.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".NutritionActivity">

    <!-- Screen title -->
    <TextView
        android:id="@+id/textScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nutrition"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Section: Calorie Summary placeholder -->
    <TextView
        android:id="@+id/textCalorieHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calorie Summary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/textScreenTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textCaloriePlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Goal: --  |  Eaten: --  |  Left: --"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/textCalorieHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Section: Hydration placeholder -->
    <TextView
        android:id="@+id/textHydrationHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hydration"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/textCaloriePlaceholder"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textHydrationPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0L / 2.5L"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/textHydrationHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Section: Today's Meals placeholder -->
    <TextView
        android:id="@+id/textMealsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's Meals"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/textHydrationPlaceholder"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textMealsPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No meals logged yet."
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/textMealsHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        Floating "+" button — placeholder for adding a meal.
        Positioned in the bottom-right corner above the nav bar.
        No click logic yet — that comes when the Nutrition screen is fully built.
    -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMeal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Add meal"
        android:src="@android:drawable/ic_input_add"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Bottom nav bar pinned to the bottom -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

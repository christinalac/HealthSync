<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/workout_bg_beige"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorkoutActivity">

    <!-- Top Blue Header Background Banner -->
    <View
        android:id="@+id/header_background"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/workout_bg_dark_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Screen title -->
    <TextView
        android:id="@+id/textScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Workout Planner 💪"
        android:textColor="@color/workout_card_white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Date/Week Subtitle Badge -->
    <TextView
        android:id="@+id/textWorkoutPlannerPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Week of Sep 14"
        android:textColor="#B6D36E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/textScreenTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 1. MONDAY'S PLAN CARD PART -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMondayPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/workout_card_white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/textWorkoutPlannerPlaceholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Card Section Header -->
            <TextView
                android:id="@+id/textWeeklyPlanHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 MONDAY'S PLAN"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/workout_bg_dark_blue"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Exercises List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExercises"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textWeeklyPlanHeader"
                tools:itemCount="4"
                tools:listitem="@layout/item_exercise" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- 2. EXERCISE INFO CARD PART -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardExerciseInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/workout_card_white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toBottomOf="@id/cardMondayPlan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:id="@+id/textExerciseInfoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ️ EXERCISE INFO - BENCH PRESS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/workout_bg_dark_blue"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Diagram Placeholder Icon -->
            <ImageView
                android:id="@+id/imageMuscleDiagram"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/sports_gym"
                android:contentDescription="Muscle diagram"
                app:layout_constraintTop_toBottomOf="@id/textExerciseInfoTitle"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Subheading: Primary Muscles -->
            <TextView
                android:id="@+id/textPrimaryMusclesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Primary Muscles"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#444444"
                app:layout_constraintTop_toTopOf="@id/imageMuscleDiagram"
                app:layout_constraintStart_toEndOf="@id/imageMuscleDiagram" />

            <!-- Tag 1: Pectorals -->
            <TextView
                android:id="@+id/tagPectorals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:text="Pectorals"
                android:textSize="12sp"
                android:textColor="@color/workout_bg_dark_blue"
                android:background="@drawable/bg_dot"
                android:backgroundTint="#E8EAF6"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                app:layout_constraintTop_toBottomOf="@id/textPrimaryMusclesTitle"
                app:layout_constraintStart_toEndOf="@id/imageMuscleDiagram" />

            <!-- Tag 2: Triceps -->
            <TextView
                android:id="@+id/tagTriceps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Triceps"
                android:textColor="@color/workout_bg_dark_blue"
                android:textSize="12sp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="#E8EAF6"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                app:layout_constraintStart_toEndOf="@id/tagPectorals"
                app:layout_constraintTop_toTopOf="@id/tagPectorals" />

            <!-- Tag 3: Front Deltoid -->
            <TextView
                android:id="@+id/tagDeltoid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Front Deltoid"
                android:textColor="@color/workout_bg_dark_blue"
                android:textSize="12sp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="#E8EAF6"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                app:layout_constraintStart_toStartOf="@id/tagPectorals"
                app:layout_constraintTop_toBottomOf="@id/tagPectorals" />

            <TextView
                android:id="@+id/textTipsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tips"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#444444"
                app:layout_constraintTop_toBottomOf="@id/imageMuscleDiagram"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Instructional description paragraph -->
            <TextView
                android:id="@+id/textTipsDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Keep back flat, grip shoulder-width, controlled descent to chest."
                android:textSize="13sp"
                android:textColor="#555555"
                android:lineSpacingMultiplier="1.2"
            app:layout_constraintTop_toBottomOf="@id/textTipsTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/fabAddWorkout"
            android:layout_marginEnd="16dp" />
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddWorkout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Add Workout"
                app:backgroundTint="#6E9C3A"
                android:src="@android:drawable/ic_input_add"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/workout_bg_dark_blue"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF" />
</androidx.constraintlayout.widget.ConstraintLayout>
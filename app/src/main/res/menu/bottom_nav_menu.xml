<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_nav_menu.xml
    Defines the 5 tabs shown in the BottomNavigationView across all screens.
    Each <item> maps to one tab — the android:id is how the Kotlin code
    identifies which tab was tapped in setOnItemSelectedListener.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/nav_home"      android:title="Home" />
    <item android:id="@+id/nav_nutrition" android:title="Nutrition" />
    <item android:id="@+id/nav_workout" android:icon="@drawable/ic_dumbell"
        android:title="Workout" />
    <item android:id="@+id/nav_sleep"     android:title="Sleep" />
    <item android:id="@+id/nav_account"   android:title="Account" />
</menu>
